# SubsRecon Frontend Environment Configuration

# Backend API base URL (Default: http://127.0.0.1:9090)
VITE_API_BASE_URL=http://127.0.0.1:9090

# UI Hosting Base Path (Subfolder / Subpath)
# Configure this if your UI is hosted in a subfolder instead of the root domain.
# Examples:
#   Root domain (https://cappriciosec.com/dashboard)        => VITE_BASE_PATH=/
#   Subfolder (https://cappriciosec.com/subrecon/dashboard)  => VITE_BASE_PATH=/subrecon
#   Subfolder (https://cappriciosec.com/subsrecon/dashboard) => VITE_BASE_PATH=/subsrecon
#   Custom folder (https://cappriciosec.com/<folder_name>/)  => VITE_BASE_PATH=/<folder_name>
VITE_BASE_PATH=/
